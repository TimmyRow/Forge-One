# Local defaults. Never commit an actual token.
FORGE_PUBLIC_MODE=0

# Required when exposing a personal Forge One instance through a tunnel.
# Open https://your-host/access?token=THIS_VALUE once to set the access cookie.
FORGE_ACCESS_TOKEN=replace-with-a-long-random-secret

# Public-mode generation guardrails (per client IP, in one hour).
FORGE_PUBLIC_JOBS_PER_HOUR=4
